## Blackbox recommended audit rules for Ubuntu 22.04/24.04 and AlmaLinux 8.
## Based on the DISA STIG rules for these systems; they record everything the
## Blackbox report needs.
##
## Recommended install (as root), on any system, including one already
## hardened with a STIG baseline such as Canonical USG:
##   blackbox check --audit-rules --missing | install -m 0600 /dev/stdin /etc/audit/rules.d/99-blackbox.rules
##   augenrules --load      (or reboot, if the rules are locked with -e 2)
## --missing prints only the rules below that are not already loaded (under
## any key name) and skips watches on paths that do not exist, so the
## baseline's own rules and keys are left as they are.
## Review against your site's STIG checklist before use.

## Larger kernel buffer, so busy systems do not drop audit records.
-b 8192

## Files and folders are watched with "-a always,exit -F path=" (or dir=)
## rules rather than "-w", as the STIGs now write them; --missing treats
## the two forms as the same rule.

## Account database edits (Account & Group Changes).
-a always,exit -F path=/etc/passwd -F perm=wa -k identity
-a always,exit -F path=/etc/group -F perm=wa -k identity
-a always,exit -F path=/etc/shadow -F perm=wa -k identity
-a always,exit -F path=/etc/gshadow -F perm=wa -k identity
-a always,exit -F path=/etc/security/opasswd -F perm=wa -k identity

## Changes to who may use sudo (Privileged Activity).
-a always,exit -F path=/etc/sudoers -F perm=wa -k privilege_modification
-a always,exit -F dir=/etc/sudoers.d/ -F perm=wa -k privilege_modification

## Logon configuration: SSH server, PAM and login security settings.
-a always,exit -F path=/etc/ssh/sshd_config -F perm=wa -k logon_config
-a always,exit -F dir=/etc/ssh/sshd_config.d/ -F perm=wa -k logon_config
-a always,exit -F dir=/etc/pam.d/ -F perm=wa -k logon_config
-a always,exit -F dir=/etc/security/ -F perm=wa -k logon_config

## Scheduled jobs and services created or changed (persistence).
-a always,exit -F path=/etc/crontab -F perm=wa -k scheduled_jobs
-a always,exit -F dir=/etc/cron.d/ -F perm=wa -k scheduled_jobs
-a always,exit -F dir=/etc/cron.daily/ -F perm=wa -k scheduled_jobs
-a always,exit -F dir=/etc/cron.hourly/ -F perm=wa -k scheduled_jobs
-a always,exit -F dir=/etc/cron.weekly/ -F perm=wa -k scheduled_jobs
-a always,exit -F dir=/etc/cron.monthly/ -F perm=wa -k scheduled_jobs
-a always,exit -F dir=/var/spool/cron/ -F perm=wa -k scheduled_jobs
-a always,exit -F dir=/etc/systemd/system/ -F perm=wa -k systemd_units
-a always,exit -F dir=/usr/lib/systemd/system/ -F perm=wa -F auid>=1000 -F auid!=unset -k systemd_units
-a always,exit -F dir=/etc/update-motd.d/ -F perm=wa -k logon_config

## Blackbox itself (AU-9): its settings, state, program and schedule. Its
## own writes (the service, with no logged-in user) are not recorded.
-a always,exit -F dir=/etc/blackbox/ -F perm=wa -k blackbox
-a always,exit -F dir=/var/lib/blackbox/ -F perm=wa -F auid>=1000 -F auid!=unset -k blackbox
## The original logs waiting to be archived: any change but Blackbox's own,
## including by a root service or script (AR6).
-a always,exit -F dir=/var/lib/blackbox/archive-pieces/ -F perm=wa -F exe!=/usr/local/bin/blackbox -k blackbox
-a always,exit -F path=/usr/local/bin/blackbox -F perm=wa -k blackbox
-a always,exit -F path=/etc/systemd/system/blackbox.service -F perm=wa -k blackbox
-a always,exit -F path=/etc/systemd/system/blackbox.timer -F perm=wa -k blackbox

## Programs that run with raised privileges, e.g. passwd, chage (Privileged Activity).
-a always,exit -F arch=b64 -S execve -C uid!=euid -F euid=0 -k execpriv
-a always,exit -F arch=b32 -S execve -C uid!=euid -F euid=0 -k execpriv
-a always,exit -F arch=b64 -S execve -C gid!=egid -F egid=0 -k execpriv
-a always,exit -F arch=b32 -S execve -C gid!=egid -F egid=0 -k execpriv

## Commands a person runs as root, including inside root shells (sudo -i, su).
-a always,exit -F arch=b64 -S execve -F euid=0 -F auid>=1000 -F auid!=unset -k root_commands
-a always,exit -F arch=b32 -S execve -F euid=0 -F auid>=1000 -F auid!=unset -k root_commands

## Privileged programs (the STIG's privileged-* rules).
-a always,exit -F path=/usr/bin/passwd -F perm=x -F auid>=1000 -F auid!=unset -k privileged-passwd
-a always,exit -F path=/usr/bin/chage -F perm=x -F auid>=1000 -F auid!=unset -k privileged-chage
-a always,exit -F path=/usr/bin/gpasswd -F perm=x -F auid>=1000 -F auid!=unset -k privileged-gpasswd
-a always,exit -F path=/usr/bin/newgrp -F perm=x -F auid>=1000 -F auid!=unset -k privileged-newgrp
-a always,exit -F path=/usr/bin/chsh -F perm=x -F auid>=1000 -F auid!=unset -k privileged-chsh
-a always,exit -F path=/usr/bin/chfn -F perm=x -F auid>=1000 -F auid!=unset -k privileged-chfn
-a always,exit -F path=/usr/bin/su -F perm=x -F auid>=1000 -F auid!=unset -k privileged-su
-a always,exit -F path=/usr/bin/sudo -F perm=x -F auid>=1000 -F auid!=unset -k privileged-sudo
-a always,exit -F path=/usr/bin/sudoedit -F perm=x -F auid>=1000 -F auid!=unset -k privileged-sudoedit
-a always,exit -F path=/usr/bin/mount -F perm=x -F auid>=1000 -F auid!=unset -k privileged-mount
-a always,exit -F path=/usr/bin/umount -F perm=x -F auid>=1000 -F auid!=unset -k privileged-umount
-a always,exit -F path=/usr/bin/crontab -F perm=x -F auid>=1000 -F auid!=unset -k privileged-crontab
-a always,exit -F path=/usr/sbin/usermod -F perm=x -F auid>=1000 -F auid!=unset -k privileged-usermod
-a always,exit -F path=/usr/bin/ssh-agent -F perm=x -F auid>=1000 -F auid!=unset -k privileged-ssh-agent
-a always,exit -F path=/usr/bin/kmod -F perm=x -F auid>=1000 -F auid!=unset -k modules
-a always,exit -F path=/usr/bin/setfacl -F perm=x -F auid>=1000 -F auid!=unset -k perm_chng
-a always,exit -F path=/usr/bin/chacl -F perm=x -F auid>=1000 -F auid!=unset -k perm_chng
-a always,exit -F path=/usr/bin/chcon -F perm=x -F auid>=1000 -F auid!=unset -k perm_chng
-a always,exit -F path=/usr/sbin/semanage -F perm=x -F auid>=1000 -F auid!=unset -k privileged-semanage
-a always,exit -F path=/usr/sbin/setfiles -F perm=x -F auid>=1000 -F auid!=unset -k privileged-setfiles
-a always,exit -F path=/usr/sbin/setsebool -F perm=x -F auid>=1000 -F auid!=unset -k privileged-setsebool
-a always,exit -F path=/usr/bin/pkexec -F perm=x -F auid>=1000 -F auid!=unset -k privileged-pkexec
-a always,exit -F path=/usr/sbin/fdisk -F perm=x -F auid>=1000 -F auid!=unset -k privileged-fdisk
-a always,exit -F path=/usr/sbin/insmod -F perm=x -F auid>=1000 -F auid!=unset -k modules
-a always,exit -F path=/usr/sbin/rmmod -F perm=x -F auid>=1000 -F auid!=unset -k modules
-a always,exit -F path=/usr/sbin/modprobe -F perm=x -F auid>=1000 -F auid!=unset -k modules
-a always,exit -F path=/usr/sbin/pam_timestamp_check -F perm=x -F auid>=1000 -F auid!=unset -k privileged-pam_timestamp_check
-a always,exit -F path=/usr/sbin/unix_update -F perm=x -F auid>=1000 -F auid!=unset -k privileged-unix-update
-a always,exit -F path=/usr/lib/openssh/ssh-keysign -F perm=x -F auid>=1000 -F auid!=unset -k privileged-ssh-keysign
-a always,exit -F path=/usr/libexec/openssh/ssh-keysign -F perm=x -F auid>=1000 -F auid!=unset -k privileged-ssh-keysign

## Files a person was refused access to (EACCES or EPERM).
-a always,exit -F arch=b64 -S creat,open,openat,open_by_handle_at,truncate,ftruncate -F exit=-EACCES -F auid>=1000 -F auid!=unset -k perm_access
-a always,exit -F arch=b32 -S creat,open,openat,open_by_handle_at,truncate,ftruncate -F exit=-EACCES -F auid>=1000 -F auid!=unset -k perm_access
-a always,exit -F arch=b64 -S creat,open,openat,open_by_handle_at,truncate,ftruncate -F exit=-EPERM -F auid>=1000 -F auid!=unset -k perm_access
-a always,exit -F arch=b32 -S creat,open,openat,open_by_handle_at,truncate,ftruncate -F exit=-EPERM -F auid>=1000 -F auid!=unset -k perm_access

## Permission and ownership changes, including setuid (perm_mod).
-a always,exit -F arch=b64 -S chmod,fchmod,fchmodat -F auid>=1000 -F auid!=unset -k perm_mod
-a always,exit -F arch=b32 -S chmod,fchmod,fchmodat -F auid>=1000 -F auid!=unset -k perm_mod
-a always,exit -F arch=b64 -S chown,fchown,fchownat,lchown -F auid>=1000 -F auid!=unset -k perm_mod
-a always,exit -F arch=b32 -S chown,fchown,fchownat,lchown -F auid>=1000 -F auid!=unset -k perm_mod
-a always,exit -F arch=b64 -S setxattr,lsetxattr,fsetxattr,removexattr,lremovexattr,fremovexattr -F auid>=1000 -F auid!=unset -k perm_mod
-a always,exit -F arch=b32 -S setxattr,lsetxattr,fsetxattr,removexattr,lremovexattr,fremovexattr -F auid>=1000 -F auid!=unset -k perm_mod

## Files deleted or renamed by a person.
-a always,exit -F arch=b64 -S unlink,unlinkat,rename,renameat,rmdir -F auid>=1000 -F auid!=unset -k delete
-a always,exit -F arch=b32 -S unlink,unlinkat,rename,renameat,rmdir -F auid>=1000 -F auid!=unset -k delete

## Kernel modules loaded or removed (Other Security Events).
-a always,exit -F arch=b64 -S init_module,finit_module,delete_module -F auid>=1000 -F auid!=unset -k module_chng
-a always,exit -F arch=b32 -S init_module,finit_module,delete_module -F auid>=1000 -F auid!=unset -k module_chng

## Filesystems mounted by a person (USB & Removable Media).
-a always,exit -F arch=b64 -S mount,umount2 -F auid>=1000 -F auid!=unset -k privileged-mount
-a always,exit -F arch=b32 -S mount,umount2 -F auid>=1000 -F auid!=unset -k privileged-mount

## System time changed by a person (Audit & System Integrity). Limited to
## logged-in users so time synchronisation daemons do not flood the log.
-a always,exit -F arch=b64 -S adjtimex,settimeofday,clock_settime -F auid>=1000 -F auid!=unset -k time-change
-a always,exit -F arch=b32 -S adjtimex,settimeofday,clock_settime -F auid>=1000 -F auid!=unset -k time-change
-a always,exit -F path=/etc/localtime -F perm=wa -k time-change

## Log files deleted or changed by a person (Audit & System Integrity).
-a always,exit -F arch=b64 -S unlink,unlinkat,rename,renameat,truncate,ftruncate -F dir=/var/log -F auid>=1000 -F auid!=unset -k log_tamper
-a always,exit -F arch=b32 -S unlink,unlinkat,rename,renameat,truncate,ftruncate -F dir=/var/log -F auid>=1000 -F auid!=unset -k log_tamper

## Logon records: utmp, wtmp, btmp, lastlog and faillock.
-a always,exit -F path=/var/run/utmp -F perm=wa -k session
-a always,exit -F path=/var/log/wtmp -F perm=wa -k logins
-a always,exit -F path=/var/log/btmp -F perm=wa -k logins
-a always,exit -F path=/var/log/lastlog -F perm=wa -k logins
-a always,exit -F dir=/var/run/faillock/ -F perm=wa -k logins

## Audit configuration and tools.
-a always,exit -F dir=/etc/audit/ -F perm=wa -k auditconfig
-a always,exit -F path=/usr/sbin/auditctl -F perm=x -k audittools
-a always,exit -F path=/usr/sbin/auditd -F perm=x -k audittools
-a always,exit -F path=/usr/sbin/augenrules -F perm=x -k audittools
-a always,exit -F path=/usr/sbin/ausearch -F perm=x -k audittools
-a always,exit -F path=/usr/sbin/aureport -F perm=x -k audittools

## Lock the rules until reboot (the STIG requires this; it must be last).
-e 2
